-	if (flush) {
-		rec = (uint8_t *)IOMallocData(SWEET_FB_SWAP_REC_SIZE);
-		if (rec != NULL) {
-			memcpy(rec, fb->fPending, SWEET_FB_SWAP_REC_SIZE);
-			fb->fDirty = false;
-		}
-		} else if (sweet_fb_alloc_fail++ < 8) {
-			IOLog("SWEET FB: swap record allocation failed\n");
-	}
-	IOLockUnlock(fb->fLock);
-	if (rec != NULL) {
-		fb->present(rec);
-		IOFreeData(rec, SWEET_FB_SWAP_REC_SIZE);
-	}
+	bool flush = fb->fDirty && (count % fb->fFlushTicks) == 0;
+	uint8_t *rec = NULL;
+	if (flush) {
+		/* One static buffer. 0087 allocated a fresh record per flush and its
+		 * failure branch misfired on every non-flush vsync (the "allocation
+		 * failed" lines in panic27 were that, not real ENOMEM). */
+		memcpy(sweet_fb_rec, fb->fPending, SWEET_FB_SWAP_REC_SIZE);
+		fb->fDirty = false;
+		rec = sweet_fb_rec;
+	}
+	IOLockUnlock(fb->fLock);
+	if (rec != NULL) {
+		fb->present(rec);
+	}
 	sender->setTimeoutUS(SWEET_FB_VSYNC_US);
 }
 

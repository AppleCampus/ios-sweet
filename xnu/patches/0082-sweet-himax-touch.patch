+/*
+ * SWEET Himax HX83112A (RMX1971 / Realme Q, SDM712) touch driver.
+ * GENI SPI master SE0 @0x880000, hardware CS, 9.6 MHz mode 0.
+ * Firmware: 64 KiB noflash image compiled in (himax_fw_19691, extracted
+ * from the OPPO GPL kernel touch.h FW_19691_HX83112A_NF_DSJM); downloaded
+ * into IC SRAM on every cold boot via the 0F flow, then the INT line
+ * (gpio 125, rising) signals 56-byte event frames read from reg 0x30.
+ * Reports into the same SweetHID pipeline the Goodix path uses:
+ * sweet_hid_touch(finger, down, x, y).
+ *
+ * Boot args: sweethimax=1 (default off), sweetmaxdelay=N (start delay, 45 s).
+ * Runtime register access is read-only except the fixed init/download
+ * sequence ported verbatim from the vendor driver (hx83112a_noflash.c).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern kern_return_t thread_terminate(thread_t);
+extern void sweet_hid_touch(int finger, int down, int x, int y);
+void sweet_himax_init(void);
+
+/* ---- board facts (RMX1971 live FDT + pinctrl-sdm670.c) ---- */
+#define HX_SE_PA	0x00880000u	/* qupv3_0 SE0, spi@880000 */
+#define HX_GCC_PA	0x00100000u
+#define HX_TLMM_PA	0x03400000u	/* live FDT: pinctrl@03400000, 0xc00000 */
+#define HX_TLMM_SOUTH	0x00900000u	/* gpio 0-3 (SE0 pins) live here */
+#define HX_TLMM_NORTH	0x00500000u	/* gpio 99 (reset), 125 (irq) */
+#define HX_GCC_VOTE	0x5200cu
+#define HX_GCC_S1_BIT	(1u << 11)	/* gcc_qupv3_wrap0_s1_clk (gcc-sdm845.c) */
+#define HX_GCC_AHB0_BIT	(1u << 17)	/* wrap0 ahb branch (verified at runtime) */
+#define HX_RCG_CBCR	0x17160u
+#define HX_GPIO_IO	0x4u
+/* map one 4 KiB page per gpio (cfg +0, in/out +4, stride 0x1000) — even a
+ * 0.5 MiB span map busted kmem_alloc with KERN_NO_SPACE on this hardware */
+#define HX_GPIO_PAGE	0x1000u
+
+/* ---- GENI SE registers (qcom-geni-se.h) ---- */
+#define SE_GENI_STATUS		0x040u
+#define SE_SER_M_CLK_CFG	0x048u
+#define SE_FW_REV		0x068u
+#define SE_CLK_SEL		0x07cu
+#define SE_SPI_CPHA		0x224u
+#define SE_SPI_LOOPBACK		0x22cu
+#define SE_SPI_CPOL		0x230u
+#define SE_SPI_DEMUX_OUTPUT_INV	0x24cu
+#define SE_SPI_DEMUX_SEL	0x250u
+#define SE_GENI_BYTE_GRAN	0x254u
+#define SE_GENI_DMA_MODE_EN	0x258u
+#define SE_SPI_TRANS_CFG	0x25cu
+#define SE_GENI_TX_PACKING_CFG0	0x260u
+#define SE_GENI_TX_PACKING_CFG1	0x264u
+#define SE_GENI_RX_PACKING_CFG0	0x284u
+#define SE_GENI_RX_PACKING_CFG1	0x288u
+#define SE_SPI_WORD_LEN		0x268u
+#define SE_SPI_TX_TRANS_LEN	0x26cu
+#define SE_SPI_RX_TRANS_LEN	0x270u
+#define SE_SPI_DELAY_COUNTERS	0x278u
+#define SE_M_CMD		0x600u
+#define SE_M_CMD_CTRL		0x604u
+#define SE_M_IRQ_STATUS		0x610u
+#define SE_M_IRQ_EN		0x614u
+#define SE_M_IRQ_CLEAR		0x618u
+#define SE_S_IRQ_EN		0x644u
+#define SE_S_IRQ_CLEAR		0x648u
+#define SE_TX_FIFO		0x700u
+#define SE_RX_FIFO		0x780u
+#define SE_RX_FIFO_STATUS	0x804u
+#define SE_HW_PARAM_0		0xe24u
+#define SE_DMA_GENERAL_CFG	0xe30u
+#define SE_GSI_EVENT_EN		0xe18u
+#define SE_IRQ_EN		0xe1cu
+#define GENI_CGC_CTRL		0x028u
+#define GENI_OUTPUT_CTRL	0x024u
+#define GENI_FORCE_DEFAULT	0x020u
+
+#define M_CMD_DONE		(1u << 0)
+#define M_CMD_CANCEL		(1u << 2)
+#define M_CMD_ABORT		(1u << 1)
+#define M_RX_WM			(1u << 26)
+#define M_RX_LAST		(1u << 27)
+#define M_TX_WM			(1u << 30)
+#define M_IRQ_COMMON		0x33c0007eu
+#define M_CMD_ACTIVE		(1u << 0)
+#define RX_FIFO_WC_MSK		0x01ffffffu
+#define RX_LAST			(1u << 31)
+#define IRQ_ERR_BITS		0x0eu
+
+#define OP_TX_ONLY		1u
+#define OP_RX_ONLY		2u
+#define PARAM_FRAG		(1u << 2)
+
+/* ---- Himax protocol ---- */
+#define HX_READ_CMD		0xF3u
+#define HX_WRITE_CMD		0xF2u
+#define HX_EVENT_FRAME		56u	/* 10 pt * 4 + 10 z + header/status */
+#define HX_POINT_CNT_OFF	52u	/* finger count byte ((10%4)?12:8 + 40) */
+#define HX_MAX_PT		10u
+#define HX_PANEL_X		1080u
+#define HX_PANEL_Y		2340u
+
+/* 0F constants (hx83112a_noflash.h, verbatim) */
+#define HX_48K_SZ		0xC000u
+#define MAX_TRANS_SZ		240u
+#define ZF_ADDR_SYS_RESET	0x90000018u
+#define ZF_DATA_SYS_RESET	0x00000055u
+#define ZF_DATA_SRAM_START	0x08000000u
+#define ZF_ADDR_DIS_RELOAD	0x10007f00u
+
+static struct {
+	vm_offset_t se, gcc, g03, g99, g125;
+	bool started, dead;
+	uint32_t active, fifodepth;
+	int x[HX_MAX_PT], y[HX_MAX_PT];
+} hx;
+
+/* the 64 KiB noflash image, generated from touch.h FW_19691_HX83112A_NF_DSJM;
+ * the header carries its own static declaration (gen_fw_header.py output) */
+#include "sweet_himax_fw_data.h"
+
+static uint32_t
+rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+wr(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static void
+hx_wait(unsigned ms)
+{
+	uint64_t deadline;
+	static int chan;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static bool
+wait_clear(vm_offset_t base, uint32_t off, uint32_t mask)
+{
+	for (unsigned i = 0; i < 5000; ++i) {
+		if (!(rd(base, off) & mask))
+			return true;
+		delay(1);
+	}
+	return false;
+}
+
+static void
+gpio_set(vm_offset_t gbase, unsigned func, unsigned pull, unsigned drive,
+    bool out, bool val)
+{
+	uint32_t cfg = rd(gbase, 0);
+	if (out) {
+		/* io_reg (+4) holds both in (bit 0) and out (bit 1) on this
+		 * TLMM generation (pinctrl-sdm670.c: io_reg +4, out_bit 1);
+		 * latch before enabling output: no glitch on the reset line */
+		wr(gbase, HX_GPIO_IO, val ? (rd(gbase, HX_GPIO_IO) | 2u) :
+		    (rd(gbase, HX_GPIO_IO) & ~2u));
+	}
+	cfg &= ~0x3ffu;
+	cfg |= pull | (func << 2) | (drive << 6) | (out ? 0x200u : 0u);
+	wr(gbase, 0, cfg);
+}
+
+static uint32_t
+gpio_read_irq(void)
+{
+	return rd(hx.g125, HX_GPIO_IO) & 1u;
+}
+
+/* ---- GENI SPI engine ---- */
+
+static bool
+se_init(void)
+{
+	uint32_t rev = rd(hx.se, SE_FW_REV);
+	hx.fifodepth = (rd(hx.se, SE_HW_PARAM_0) >> 16) & 0x3fu;
+	printf("SWEET HMAX: se fw=%#x proto=%u fifodepth=%u\n",
+	    rev, (rev >> 8) & 0xffu, hx.fifodepth);
+	if (((rev >> 8) & 0xffu) != 1u) {
+		printf("SWEET HMAX: SE is not SPI; abort\n");
+		return false;
+	}
+
+	/* se_io_init + fifo mode (qcom-geni-se.c) */
+	wr(hx.se, GENI_CGC_CTRL, rd(hx.se, GENI_CGC_CTRL) | 0x7fu);
+	wr(hx.se, SE_DMA_GENERAL_CFG, rd(hx.se, SE_DMA_GENERAL_CFG) | 0x0fu);
+	wr(hx.se, GENI_OUTPUT_CTRL, 0x7fu);
+	wr(hx.se, GENI_FORCE_DEFAULT, 1u);
+	wr(hx.se, SE_IRQ_EN, rd(hx.se, SE_IRQ_EN) | 0x0fu);
+	wr(hx.se, SE_GSI_EVENT_EN, 0);
+	wr(hx.se, SE_GENI_DMA_MODE_EN, rd(hx.se, SE_GENI_DMA_MODE_EN) & ~1u);
+	wr(hx.se, SE_M_IRQ_CLEAR, 0xffffffffu);
+	wr(hx.se, SE_S_IRQ_CLEAR, 0xffffffffu);
+	wr(hx.se, SE_M_IRQ_EN, rd(hx.se, SE_M_IRQ_EN) | M_IRQ_COMMON |
+	    M_CMD_DONE | M_RX_WM | M_RX_LAST | M_TX_WM);
+	wr(hx.se, SE_S_IRQ_EN, rd(hx.se, SE_S_IRQ_EN) | M_CMD_DONE);
+
+	/* spi mode 0, 8 bpw, CS0, 9.6 MHz from the 19.2 MHz DFS level (idx 2) */
+	wr(hx.se, SE_SPI_LOOPBACK, rd(hx.se, SE_SPI_LOOPBACK) & ~0x3u);
+	wr(hx.se, SE_SPI_DEMUX_SEL, 0);
+	wr(hx.se, SE_SPI_CPHA, rd(hx.se, SE_SPI_CPHA) & ~1u);
+	wr(hx.se, SE_SPI_CPOL, rd(hx.se, SE_SPI_CPOL) & ~0x4u);
+	wr(hx.se, SE_SPI_DEMUX_OUTPUT_INV, 0);
+	wr(hx.se, SE_CLK_SEL, 2);
+	wr(hx.se, SE_SER_M_CLK_CFG, (2u << 4) | 1u);
+	/* 4 x 8-bit words per FIFO word, MSB-first on the wire */
+	wr(hx.se, SE_GENI_TX_PACKING_CFG0, 0xc010u);
+	wr(hx.se, SE_GENI_TX_PACKING_CFG1, 0x1c450u);
+	wr(hx.se, SE_GENI_RX_PACKING_CFG0, 0xc010u);
+	wr(hx.se, SE_GENI_RX_PACKING_CFG1, 0x1c450u);
+	wr(hx.se, SE_GENI_BYTE_GRAN, 0);
+	wr(hx.se, SE_SPI_WORD_LEN, (rd(hx.se, SE_SPI_WORD_LEN) & ~0x3ffu) | 4u);
+	wr(hx.se, SE_SPI_DELAY_COUNTERS, 0);
+	return true;
+}
+
+static bool
+m_cmd_wait_done(void)
+{
+	for (unsigned i = 0; i < 20000; ++i) {
+		uint32_t irq = rd(hx.se, SE_M_IRQ_STATUS);
+		if (irq & IRQ_ERR_BITS) {
+			wr(hx.se, SE_M_IRQ_CLEAR, irq);
+			hx.dead = true;
+			return false;
+		}
+		if (irq & M_CMD_DONE) {
+			wr(hx.se, SE_M_IRQ_CLEAR, irq);
+			return true;
+		}
+		delay(1);
+	}
+	wr(hx.se, SE_M_CMD_CTRL, M_CMD_CANCEL);
+	hx_wait(2);
+	wr(hx.se, SE_M_CMD_CTRL, M_CMD_ABORT);
+	wr(hx.se, SE_M_IRQ_CLEAR, 0xffffffffu);
+	hx.dead = true;
+	return false;
+}
+
+/*
+ * One TX-only FIFO message, split into FIFO-sized chunks; CS stays low
+ * across the whole message (FRAGMENTATION on every m_cmd but the last).
+ * Pre-fills each chunk, then issues the command (the sequencer waits for
+ * FIFO data, but pre-fill-then-issue is the safe bare-metal pattern).
+ */
+static int
+spi_tx(const uint8_t *tx, unsigned len)
+{
+	unsigned done = 0;
+	if (hx.dead || len == 0)
+		return EIO;
+	if (!wait_clear(hx.se, SE_GENI_STATUS, M_CMD_ACTIVE)) {
+		hx.dead = true;
+		return EBUSY;
+	}
+	wr(hx.se, SE_M_IRQ_CLEAR, 0xffffffffu);
+	wr(hx.se, SE_SPI_TRANS_CFG, rd(hx.se, SE_SPI_TRANS_CFG) & ~1u);
+	while (done < len) {
+		unsigned chunk = len - done;
+		bool last = chunk <= hx.fifodepth * 4u;
+		if (chunk > hx.fifodepth * 4u)
+			chunk = hx.fifodepth * 4u;
+		wr(hx.se, SE_SPI_TX_TRANS_LEN, chunk);
+		for (unsigned i = 0; i < chunk; i += 4) {
+			uint32_t word = 0;
+			for (unsigned j = 0; j < 4 && done + i + j < len; ++j)
+				word |= (uint32_t)tx[done + i + j] << (8u * j);
+			wr(hx.se, SE_TX_FIFO, word);
+		}
+		wr(hx.se, SE_M_CMD, (OP_TX_ONLY << 27) | (last ? 0u : PARAM_FRAG));
+		if (!m_cmd_wait_done())
+			return EIO;
+		done += chunk;
+	}
+	return 0;
+}
+
+/*
+ * Himax bus read: [0xF3 reg 0x00] out, then len bytes in, CS low throughout
+ * (FRAGMENTATION chains the two m_cmds). len <= 4 * fifodepth assumed
+ * (the largest read here is the 56-byte frame; the FIFO is >= 64 bytes).
+ */
+static int
+bus_read(uint8_t cmd, uint8_t *data, unsigned len)
+{
+	if (hx.dead)
+		return EIO;
+	if (!wait_clear(hx.se, SE_GENI_STATUS, M_CMD_ACTIVE)) {
+		hx.dead = true;
+		return EBUSY;
+	}
+	wr(hx.se, SE_M_IRQ_CLEAR, 0xffffffffu);
+	wr(hx.se, SE_SPI_TRANS_CFG, rd(hx.se, SE_SPI_TRANS_CFG) & ~1u);
+	/* command phase, CS held */
+	wr(hx.se, SE_SPI_TX_TRANS_LEN, 3);
+	{
+		uint32_t word = (uint32_t)HX_READ_CMD | ((uint32_t)cmd << 8);
+		wr(hx.se, SE_TX_FIFO, word);
+	}
+	wr(hx.se, SE_M_CMD, (OP_TX_ONLY << 27) | PARAM_FRAG);
+	if (!m_cmd_wait_done())
+		return EIO;
+	/* read phase, CS released at the end */
+	wr(hx.se, SE_SPI_RX_TRANS_LEN, len);
+	wr(hx.se, SE_M_CMD, OP_RX_ONLY << 27);
+	unsigned got = 0;
+	for (unsigned i = 0; i < 30000 && got < len; ++i) {
+		uint32_t st = rd(hx.se, SE_RX_FIFO_STATUS);
+		unsigned wc = st & RX_FIFO_WC_MSK;
+		unsigned valid = 4;
+		if (st & RX_LAST) {
+			unsigned v = (st >> 28) & 0x7u;
+			if (v && v < 4)
+				valid = v;
+		}
+		for (unsigned w = 0; w < wc && got < len; ++w) {
+			uint32_t word = rd(hx.se, SE_RX_FIFO);
+			for (unsigned j = 0; j < 4 && got < len; ++j)
+				data[got++] = (uint8_t)(word >> (8u * j));
+		}
+		if (got >= len)
+			break;
+		uint32_t irq = rd(hx.se, SE_M_IRQ_STATUS);
+		if (irq & IRQ_ERR_BITS) {
+			wr(hx.se, SE_M_IRQ_CLEAR, irq);
+			hx.dead = true;
+			return EIO;
+		}
+		if (irq & (M_RX_WM | M_RX_LAST))
+			wr(hx.se, SE_M_IRQ_CLEAR, irq & (M_RX_WM | M_RX_LAST));
+		delay(1);
+	}
+	return m_cmd_wait_done() ? (got == len ? 0 : EIO) : EIO;
+}
+
+/* 0xF2 cmd + up to 4 + 48 KiB payload: the vendor downloads the whole SRAM
+ * image as ONE bus_write burst (himax_bus_write allocates 49152 bytes), and
+ * spi_tx splits it into FIFO chunks with CS held. Single driver thread, so
+ * one static buffer is fine. */
+static uint8_t hx_txbuf[2u + 4u + HX_48K_SZ + 16u];
+
+static int
+bus_write(uint8_t cmd, const uint8_t *data, unsigned len)
+{
+	if (hx.dead || 2u + len > sizeof(hx_txbuf))
+		return EIO;
+	hx_txbuf[0] = HX_WRITE_CMD;
+	hx_txbuf[1] = cmd;
+	for (unsigned i = 0; i < len; ++i)
+		hx_txbuf[2 + i] = data[i];
+	return spi_tx(hx_txbuf, 2u + len);
+}
+
+/* ---- Himax AHB layer (vendor hx83112a_noflash.c logic, verbatim) ---- */
+
+static void
+flash_write_burst(uint32_t addr, const uint8_t *data, unsigned len)
+{
+	uint8_t buf[8];
+	buf[0] = addr & 0xff; buf[1] = (addr >> 8) & 0xff;
+	buf[2] = (addr >> 16) & 0xff; buf[3] = (addr >> 24) & 0xff;
+	for (unsigned i = 0; i < 4 && i < len; ++i)
+		buf[4 + i] = data[i];
+	(void)bus_write(0x00, buf, 8);
+}
+
+static void
+burst_enable(uint8_t auto_add_4)
+{
+	uint8_t d = 0x31;
+	(void)bus_write(0x13, &d, 1);
+	d = (uint8_t)(0x10 | auto_add_4);
+	(void)bus_write(0x0d, &d, 1);
+}
+
+static void
+register_write(uint32_t addr, const uint8_t *data, unsigned len)
+{
+	uint8_t buf[4 + MAX_TRANS_SZ];
+	buf[0] = addr & 0xff; buf[1] = (addr >> 8) & 0xff;
+	buf[2] = (addr >> 16) & 0xff; buf[3] = (addr >> 24) & 0xff;
+	for (unsigned i = 0; i < len && i < MAX_TRANS_SZ; ++i)
+		buf[4 + i] = data[i];
+	burst_enable(len > 4 ? 1 : 0);
+	(void)bus_write(0x00, buf, 4u + len);
+}
+
+static void
+register_read(uint32_t addr, uint8_t *data, unsigned len)
+{
+	uint8_t a[4] = { addr & 0xff, (addr >> 8) & 0xff,
+	    (addr >> 16) & 0xff, (addr >> 24) & 0xff };
+	uint8_t zero = 0;
+	burst_enable(len > 4 ? 1 : 0);
+	(void)bus_write(0x00, a, 4);
+	(void)bus_write(0x0c, &zero, 1);
+	(void)bus_read(0x08, data, len);
+	if (len > 4)
+		burst_enable(0);
+}
+
+static void
+interface_on(void)
+{
+	uint8_t d[5];
+	if (bus_read(0x08, d, 4) != 0)
+		return;
+	for (unsigned cnt = 0; cnt < 10; ++cnt) {
+		uint8_t b31 = 0x31, b10 = 0x10;
+		uint8_t chk1 = 0, chk2 = 0;
+		(void)bus_write(0x13, &b31, 1);
+		(void)bus_write(0x0d, &b10, 1);
+		(void)bus_read(0x13, &chk1, 1);
+		(void)bus_read(0x0d, &chk2, 1);
+		if (chk1 == 0x31 && chk2 == 0x10)
+			return;
+		hx_wait(1);
+	}
+}
+
+/* ---- 0F firmware download (vendor verbatim logic) ---- */
+
+static uint32_t
+hw_check_crc(uint32_t start_addr, unsigned len)
+{
+	uint8_t d4[4];
+	uint8_t sa[4] = { start_addr & 0xff, (start_addr >> 8) & 0xff,
+	    (start_addr >> 16) & 0xff, (start_addr >> 24) & 0xff };
+	uint8_t len4[4] = { (len / 4) & 0xff, ((len / 4) >> 8) & 0xff, 0x99, 0x00 };
+
+	flash_write_burst(0x80050020u, sa, 4);
+	flash_write_burst(0x80050028u, len4, 4);
+	for (unsigned cnt = 0; cnt < 100; ++cnt) {
+		register_read(0x80050000u, d4, 4);
+		if (!(d4[0] & 0x01u)) {
+			register_read(0x80050018u, d4, 4);
+			return ((uint32_t)d4[3] << 24) | ((uint32_t)d4[2] << 16) |
+			    ((uint32_t)d4[1] << 8) | d4[0];
+		}
+	}
+	return 0xffffffffu;
+}
+
+/* the vendor writes each SRAM region (incl. the full 48 KiB image) as ONE
+ * flash_write_burst_length burst: addr prefix + payload, auto-increment on */
+static uint8_t hx_sram[4u + HX_48K_SZ];
+
+static void
+write_sram_0f(uint32_t dest, unsigned src_off, unsigned len)
+{
+	hx_sram[0] = dest & 0xff;
+	hx_sram[1] = (dest >> 8) & 0xff;
+	hx_sram[2] = (dest >> 16) & 0xff;
+	hx_sram[3] = (dest >> 24) & 0xff;
+	for (unsigned i = 0; i < len; ++i)
+		hx_sram[4 + i] = himax_fw_19691[src_off + i];
+	burst_enable(1);
+	(void)bus_write(0x00, hx_sram, 4u + len);
+}
+
+static bool
+enter_safe_mode(void)
+{
+	uint8_t a5[4] = { 0xa5, 0, 0, 0 };
+	uint8_t zero[4] = { 0, 0, 0, 0 };
+	uint8_t one[4] = { 1, 0, 0, 0 };
+	uint8_t d4[4];
+
+	flash_write_burst(0x9000005cu, a5, 4);
+	hx_wait(20);
+	for (unsigned cnt = 0; cnt < 20; ++cnt) {
+		uint8_t b27 = 0x27, b95 = 0x95, b00 = 0x00;
+		(void)bus_write(0x31, &b27, 1);
+		(void)bus_write(0x32, &b95, 1);
+		(void)bus_write(0x31, &b00, 1);
+		(void)bus_write(0x31, &b27, 1);
+		(void)bus_write(0x32, &b95, 1);
+		register_read(0x900000a8u, d4, 4);
+		if (d4[0] == 0x0cu) {
+			/* reset TCON, then ADC (vendor enter_safe_mode tail) */
+			flash_write_burst(0x80020020u, zero, 4);
+			hx_wait(1);
+			flash_write_burst(0x80020020u, one, 4);
+			flash_write_burst(0x80020094u, zero, 4);
+			hx_wait(1);
+			flash_write_burst(0x80020094u, one, 4);
+			return true;
+		}
+		hx_wait(10);
+	}
+	return false;
+}
+
+static void
+sense_on(void)
+{
+	uint8_t zero[4] = { 0, 0, 0, 0 };
+	uint8_t r55[4] = { 0x55, 0, 0, 0 };
+	interface_on();				/* vendor sense_on leads
+						 * with the burst handshake */
+	flash_write_burst(0x9000005cu, zero, 4);
+	register_write(0x90000018u, r55, 4);	/* AHBI2C system reset */
+}
+
+static bool
+fw_download(void)
+{
+	uint8_t d4[4];
+	uint32_t crc = 0xffffffffu;
+	uint8_t reset55[4] = { 0x55, 0, 0, 0 };
+
+	register_write(ZF_ADDR_SYS_RESET, reset55, 4);
+	printf("SWEET HMAX: sys reset done\n");
+	hx_wait(1500);
+	if (!enter_safe_mode()) {
+		printf("SWEET HMAX: safe mode failed\n");
+		return false;
+	}
+	printf("SWEET HMAX: safe mode ok\n");
+	hx_wait(1500);
+	for (unsigned retry = 0; retry < 10 && crc != 0; ++retry) {
+		write_sram_0f(ZF_DATA_SRAM_START, 0, HX_48K_SZ);
+		crc = hw_check_crc(ZF_DATA_SRAM_START, HX_48K_SZ);
+		if (crc != 0)
+			printf("SWEET HMAX: 48k CRC fail (%#x) retry %u\n", crc, retry);
+	}
+	if (crc != 0)
+		return false;
+	printf("SWEET HMAX: 48k crc ok\n");
+	hx_wait(1500);
+	write_sram_0f(0x10007000u, 0xC000u, 128u);
+	write_sram_0f(0x10007084u, 0xC100u, 528u);
+	write_sram_0f(0x10007300u, 0xCA00u, 128u);
+	write_sram_0f(0x10006A00u, 0xD640u, 1200u);
+	write_sram_0f(0x10007B28u, 0xD320u, 800u);
+	write_sram_0f(0x10007500u, 0xE000u, 1536u);
+	write_sram_0f(0x10007294u, 0xC30Cu, 4u);	/* mode switch: poweron
+							 * (0xC30C: the <=64K
+							 * path; 0xC33C is the
+							 * >64K bin path) */
+	printf("SWEET HMAX: tables written\n");
+
+	/* disable flash reload, verify readback (vendor hx_dis_rload_0f) */
+	uint8_t dr[4] = { 0xa9, 0x9a, 0x00, 0x00 };
+	flash_write_burst(ZF_ADDR_DIS_RELOAD, dr, 4);
+	register_read(ZF_ADDR_DIS_RELOAD, d4, 4);
+	if (d4[3] || d4[2] || d4[1] != 0x9au || d4[0] != 0xa9u)
+		printf("SWEET HMAX: reload verify=%02x%02x%02x%02x (want 00009aa9)\n",
+		    d4[3], d4[2], d4[1], d4[0]);
+	hx_wait(10);
+	register_read(0x10007014u, d4, 4);		/* FW ID */
+	printf("SWEET HMAX: fw id = %02x%02x%02x%02x (want ea159003)\n",
+	    d4[0], d4[1], d4[2], d4[3]);
+	hx_wait(10);
+	sense_on();
+	hx_wait(10);
+	return true;
+}
+
+/* ---- event frame ---- */
+
+static bool
+read_frame(uint8_t *buf)
+{
+	uint8_t off = 0, on = 1;
+	if (bus_write(0x11, &off, 1) != 0)		/* AHB burst read off */
+		return false;
+	if (bus_read(0x30, buf, HX_EVENT_FRAME) != 0)
+		return false;
+	(void)bus_write(0x11, &on, 1);			/* burst read on */
+	return true;
+}
+
+static void
+report(uint32_t mask, const int *x, const int *y)
+{
+	for (unsigned id = 0; id < HX_MAX_PT; ++id) {
+		uint32_t bit = 1u << id;
+		if (mask & bit) {
+			if (!(hx.active & bit) || x[id] != hx.x[id] || y[id] != hx.y[id])
+				sweet_hid_touch((int)id, 1, x[id], y[id]);
+			hx.x[id] = x[id];
+			hx.y[id] = y[id];
+		} else if (hx.active & bit) {
+			sweet_hid_touch((int)id, 0, hx.x[id], hx.y[id]);
+		}
+	}
+	hx.active = mask;
+}
+
+static void
+hx_thread(void *arg, wait_result_t result)
+{
+	unsigned delay_s = 45;
+	(void)arg;
+	(void)result;
+	(void)PE_parse_boot_argn("sweetmaxdelay", &delay_s, sizeof(delay_s));
+	printf("SWEET HMAX: starting in %u s\n", delay_s);
+	hx_wait(delay_s * 1000u);
+
+	hx.se = ml_io_map(HX_SE_PA, 0x4000);
+	hx.gcc = ml_io_map(HX_GCC_PA, 0x60000);
+	hx.g03 = ml_io_map(HX_TLMM_PA + HX_TLMM_SOUTH, 4u * HX_GPIO_PAGE);
+	hx.g99 = ml_io_map(HX_TLMM_PA + HX_TLMM_NORTH + 99u * HX_GPIO_PAGE,
+	    HX_GPIO_PAGE);
+	hx.g125 = ml_io_map(HX_TLMM_PA + HX_TLMM_NORTH + 125u * HX_GPIO_PAGE,
+	    HX_GPIO_PAGE);
+	if (!hx.se || !hx.gcc || !hx.g03 || !hx.g99 || !hx.g125) {
+		printf("SWEET HMAX: MMIO map failed\n");
+		goto out;
+	}
+	printf("SWEET HMAX: maps ok\n");
+	/* clocks: vote wrap0_s1 + wrap0 ahb, verify the RCG comes out of halt */
+	wr(hx.gcc, HX_GCC_VOTE, rd(hx.gcc, HX_GCC_VOTE) |
+	    HX_GCC_S1_BIT | HX_GCC_AHB0_BIT);
+	printf("SWEET HMAX: vote=%#x cbcr=%#x rcgcfg=%#x dfs=%#x\n",
+	    rd(hx.gcc, HX_GCC_VOTE), rd(hx.gcc, HX_RCG_CBCR),
+	    rd(hx.gcc, HX_RCG_CBCR + 0x8u), rd(hx.gcc, HX_RCG_CBCR + 0x14u));
+	if (!wait_clear(hx.gcc, HX_RCG_CBCR, 1u)) {
+		printf("SWEET HMAX: RCG halt timeout; clock integration needed\n");
+		goto out;
+	}
+	printf("SWEET HMAX: clock settled\n");
+	if (!se_init())
+		goto out;
+
+	/* 1.5 s pauses between steps: the persistent log flushes once a
+	 * second, so each anchor lands on disk even if the next step kills
+	 * the kernel */
+	hx_wait(1500);
+	/* pins: qup0 mux=1 on gpio0-3 (SOUTH); reset 99 out; irq 125 in, pull-up */
+	for (unsigned p = 0; p < 4; ++p)
+		gpio_set(hx.g03 + p * HX_GPIO_PAGE, 1, 0, 2, false, false);
+	printf("SWEET HMAX: spi pins muxed\n");
+	hx_wait(1500);
+	gpio_set(hx.g99, 0, 0, 2, true, true);		/* reset high */
+	gpio_set(hx.g125, 0, 3, 3, false, false);	/* irq input, pull-up */
+	printf("SWEET HMAX: reset high, irq input\n");
+	hx_wait(50);
+	/* hardware reset pulse: low 2 ms, high 2 ms (vendor resetgpio_set) */
+	gpio_set(hx.g99, 0, 0, 2, true, false);
+	hx_wait(2);
+	gpio_set(hx.g99, 0, 0, 2, true, true);
+	hx_wait(2);
+	printf("SWEET HMAX: reset pulsed\n");
+	hx_wait(1500);
+
+	if (!fw_download()) {
+		printf("SWEET HMAX: fw download failed; stopping\n");
+		goto out;
+	}
+	printf("SWEET HMAX: fw loaded, polling INT every 10 ms\n");
+	unsigned errors = 0;
+	while (!hx.dead) {
+		if (gpio_read_irq() != 0u) {
+			uint8_t buf[HX_EVENT_FRAME];
+			if (!read_frame(buf)) {
+				if ((errors++ % 100u) == 0)
+					printf("SWEET HMAX: frame err=%u dead=%d\n",
+					    errors, hx.dead);
+				if (errors == 10)
+					report(0, hx.x, hx.y);
+			} else {
+				unsigned sum = 0;
+				bool allz = true;
+				for (unsigned i = 0; i < HX_EVENT_FRAME; ++i) {
+					sum += buf[i];
+					if (buf[i] != 0)
+						allz = false;
+				}
+				if (!allz && (sum & 0xffu) == 0) {
+					int x[HX_MAX_PT] = {0}, y[HX_MAX_PT] = {0};
+					uint32_t mask = 0;
+					for (unsigned i = 0; i < HX_MAX_PT; ++i) {
+						unsigned px = (buf[i * 4] << 8) | buf[i * 4 + 1];
+						unsigned py = (buf[i * 4 + 2] << 8) | buf[i * 4 + 3];
+						if (px <= HX_PANEL_X - 1u && py <= HX_PANEL_Y - 1u &&
+						    (px || py)) {
+							mask |= 1u << i;
+							x[i] = (int)px;
+							y[i] = (int)py;
+						}
+					}
+					report(mask, x, y);
+					errors = 0;
+				}
+			}
+		}
+		hx_wait(10);
+	}
+	report(0, hx.x, hx.y);
+out:
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+sweet_himax_init(void)
+{
+	int enabled = 0;
+	thread_t thread;
+	if (hx.started)
+		return;
+	hx.started = true;
+	(void)PE_parse_boot_argn("sweethimax", &enabled, sizeof(enabled));
+	if (!enabled) {
+		printf("SWEET HMAX: disabled (sweethimax=0)\n");
+		return;
+	}
+	kern_return_t kr = kernel_thread_start(hx_thread, NULL, &thread);
+	if (kr == 0)
+		thread_deallocate(thread);
+	else
+		printf("SWEET HMAX: kernel_thread_start failed %d\n", kr);
+}

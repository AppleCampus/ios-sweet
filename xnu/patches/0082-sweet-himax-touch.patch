+		    rd(hx.gcc, HX_RCG_S0_CBCR + 0x24u),
+		    rd(hx.gcc, HX_RCG_S0_CBCR + 0x28u),
+		    rd(hx.gcc, HX_RCG_S0_CBCR + 0x2cu));
+		sweet_log_flush_sync();
+		if (dfs & 1u) {
+			if ((rd(hx.gcc, HX_RCG_S0_CBCR + 0x20u) & 0x1ffu) == 0) {
+				wr(hx.gcc, HX_RCG_S0_CBCR + 0x20u, 1u); /* CXO, /2 */
+				printf("SWEET HMAX: dfs slot0 programmed 9.6MHz\n");
+			} else {
+				printf("SWEET HMAX: dfs slot0 valid\n");
+			}
+			sweet_log_flush_sync();
+		} else {
+			/* plain RCG: force CXO/1 and strobe UPDATE */
+			wr(hx.gcc, HX_RCG_S0_CFG, 0);
+			wr(hx.gcc, HX_RCG_S0_CMD, 1u);
+			(void)wait_clear(hx.gcc, HX_RCG_S0_CMD, 1u);
+			printf("SWEET HMAX: rcg reprogrammed cfg=%#x\n",
+			    rd(hx.gcc, HX_RCG_S0_CFG));
+			sweet_log_flush_sync();
+		}
+	}
+	if (!se_init())
+		goto out;
+
+	/* every say() flushes the ring to UFS before the next risky step */
+	say("step: mux spi pins gpio0-3");
+	for (unsigned p = 0; p < 4; ++p)
+		gpio_set(hx.g03 + p * HX_GPIO_PAGE, 1, 0, 2, false, false);
+	say("step: reset gpio99 out, irq gpio125 in");
+	gpio_set(hx.g99, 0, 0, 2, true, true);		/* reset high */
+	gpio_set(hx.g125, 0, 3, 3, false, false);	/* irq input, pull-up */
+	say("step: reset pulse");
+	hx_wait(50);
+	/* hardware reset pulse: low 2 ms, high 2 ms (vendor resetgpio_set
+	 * drives reset high and then msleep(RESET_TO_NORMAL_TIME = 2)); the
+	 * extra 50 ms is the IC's own boot time before it answers SPI */
+	gpio_set(hx.g99, 0, 0, 2, true, false);
+	hx_wait(2);
+	gpio_set(hx.g99, 0, 0, 2, true, true);
+	hx_wait(50);
+	say("step: first SPI tx (sys reset)");
+	wire_probe();
+	{
+		uint8_t r55[4] = { 0x55, 0, 0, 0 };
+		register_write(ZF_ADDR_SYS_RESET, r55, 4);
+	}
+	say("sys reset done");

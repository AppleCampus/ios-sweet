+	 * chain read for the rest of this boot */
+	say("probe: fd read");
+	hx_use_fd = true;
+	{
+		uint8_t chk[4] = { 0 };
+		if (bus_read(0x08, chk, 4) == 0) {
+			printf("SWEET HMAX: fd read ok d=%02x%02x%02x%02x\n",
+			    chk[0], chk[1], chk[2], chk[3]);
+		} else {
+			printf("SWEET HMAX: fd read failed -> frag fallback\n");
+			bus_reset();
+			hx_use_fd = false;
+		}
+		sweet_log_flush_sync();
+	}
+	/* bus-alive probe: burst enable + readback (vendor himax_interface_on);
+	 * the chk values prove whether the IC answers at all */
+	interface_on();
+	say("if_on done");
+
+	if (!fw_download()) {
+		printf("SWEET HMAX: fw download failed; stopping\n");
+		sweet_log_flush_sync();
+		goto out;
+	}
+	printf("SWEET HMAX: fw loaded, polling INT every 10 ms\n");
+	sweet_log_flush_sync();
+	unsigned errors = 0;
+	while (!hx.dead) {
+		if (gpio_read_irq() != 0u) {
+			uint8_t buf[HX_EVENT_FRAME];
+			if (!read_frame(buf)) {
+				if ((errors++ % 100u) == 0)
+					printf("SWEET HMAX: frame err=%u dead=%d\n",
+					    errors, hx.dead);
+				if (errors == 10)
+					report(0, hx.x, hx.y);
+			} else {
+				unsigned sum = 0;
+				bool allz = true;
+				for (unsigned i = 0; i < HX_EVENT_FRAME; ++i) {
+					sum += buf[i];
+					if (buf[i] != 0)
+						allz = false;
+				}
+				if (!allz && (sum & 0xffu) == 0) {
+					int x[HX_MAX_PT] = {0}, y[HX_MAX_PT] = {0};
+					uint32_t mask = 0;
+					for (unsigned i = 0; i < HX_MAX_PT; ++i) {
+						unsigned px = (buf[i * 4] << 8) | buf[i * 4 + 1];
+						unsigned py = (buf[i * 4 + 2] << 8) | buf[i * 4 + 3];
+						if (px <= HX_PANEL_X - 1u && py <= HX_PANEL_Y - 1u &&
+						    (px || py)) {
+							mask |= 1u << i;
+							x[i] = (int)px;
+							y[i] = (int)py;
+						}
+					}
+					report(mask, x, y);
+					errors = 0;
+				}
+			}
+		}
+		hx_wait(10);
+	}
+	report(0, hx.x, hx.y);
+out:
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+sweet_himax_init(void)
+{
+	int enabled = 0;
+	thread_t thread;
+	if (hx.started)
+		return;
+	hx.started = true;
+	(void)PE_parse_boot_argn("sweethimax", &enabled, sizeof(enabled));
+	if (!enabled) {
+		printf("SWEET HMAX: disabled (sweethimax=0)\n");
+		return;
+	}
+	kern_return_t kr = kernel_thread_start(hx_thread, NULL, &thread);
+	if (kr == 0)
+		thread_deallocate(thread);
+	else
+		printf("SWEET HMAX: kernel_thread_start failed %d\n", kr);
+}

+/*
+ * SWEET Himax HX83112A (RMX1971 / Realme Q, SDM712) touch driver.
+ * GENI SPI master SE0 @0x880000, hardware CS, 9.6 MHz mode 0.
+ * Firmware: 64 KiB noflash image compiled in (himax_fw_19691, extracted
+ * from the OPPO GPL kernel touch.h FW_19691_HX83112A_NF_DSJM); downloaded
+ * into IC SRAM on every cold boot via the 0F flow, then the INT line
+ * (gpio 125, rising) signals 56-byte event frames read from reg 0x30.
+ * Reports into the same SweetHID pipeline the Goodix path uses:
+ * sweet_hid_touch(finger, down, x, y).
+ *
+ * Boot args: sweethimax=1 (default off), sweetmaxdelay=N (start delay, 45 s).
+ * Runtime register access is read-only except the fixed init/download
+ * sequence ported verbatim from the vendor driver (hx83112a_noflash.c).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern uint64_t ml_get_timebase(void);
+extern kern_return_t thread_terminate(thread_t);
+extern void sweet_hid_touch(int finger, int down, int x, int y);
+extern void sweet_log_flush_sync(void);	/* bsd/dev/sweet_ufs.c */
+extern int sweet_rpmh_vreg_enable(const char *res, unsigned mv);
+void sweet_himax_init(void);
+
+/* ---- board facts (RMX1971 live FDT + pinctrl-sdm670.c) ---- */
+#define HX_SE_PA	0x00880000u	/* qupv3_0 SE0, spi@880000 */
+#define HX_GCC_PA	0x00100000u
+#define HX_TLMM_PA	0x03400000u	/* live FDT: pinctrl@03400000, 0xc00000 */
+#define HX_TLMM_SOUTH	0x00900000u	/* gpio 0-3 (SE0 pins) live here */
+#define HX_TLMM_NORTH	0x00500000u	/* gpio 99 (reset), 125 (irq) */
+#define HX_GCC_VOTE	0x5200cu
+#define HX_GCC_S0_BIT	(1u << 10)	/* gcc_qupv3_wrap0_s0_clk: SE0's serial
+					 * clock (halt 0x17030, gcc-sdm845.c);
+					 * S1/bit11 feeds SE1, not SE0 */
+#define HX_GCC_AHB0_BIT	(1u << 17)	/* wrap0 ahb branch (verified at runtime) */
+#define HX_RCG_S0_CBCR	0x17030u	/* s0 branch CBCR; CMD +4, CFG +8 */
+#define HX_RCG_S0_CMD	0x17034u	/* UPDATE = bit 0 (clk-rcg2.c) */
+#define HX_RCG_S0_CFG	0x17038u	/* bit20 = DFS mode; src [10:8]; div low */
+#define HX_GPIO_IO	0x4u
+/* map one 4 KiB page per gpio (cfg +0, in/out +4, stride 0x1000) — even a
+ * 0.5 MiB span map busted kmem_alloc with KERN_NO_SPACE on this hardware */
+#define HX_GPIO_PAGE	0x1000u
+
+/* ---- GENI SE registers (qcom-geni-se.h) ---- */
+#define SE_GENI_STATUS		0x040u
+#define SE_SER_M_CLK_CFG	0x048u
+#define SE_FW_REV		0x068u
+#define SE_CLK_SEL		0x07cu
+#define SE_SPI_CPHA		0x224u
+#define SE_SPI_LOOPBACK		0x22cu
+#define SE_SPI_CPOL		0x230u
+#define SE_SPI_DEMUX_OUTPUT_INV	0x24cu
+#define SE_SPI_DEMUX_SEL	0x250u
+#define SE_GENI_BYTE_GRAN	0x254u
+#define SE_GENI_DMA_MODE_EN	0x258u
+#define SE_SPI_TRANS_CFG	0x25cu
+#define SE_GENI_TX_PACKING_CFG0	0x260u
+#define SE_GENI_TX_PACKING_CFG1	0x264u
+#define SE_GENI_RX_PACKING_CFG0	0x284u
+#define SE_GENI_RX_PACKING_CFG1	0x288u
+#define SE_SPI_WORD_LEN		0x268u
+#define SE_SPI_TX_TRANS_LEN	0x26cu
+#define SE_SPI_RX_TRANS_LEN	0x270u
+#define SE_SPI_DELAY_COUNTERS	0x278u
+#define SE_M_CMD		0x600u
+#define SE_M_CMD_CTRL		0x604u
+#define SE_M_IRQ_STATUS		0x610u
+#define SE_M_IRQ_EN		0x614u
+#define SE_M_IRQ_CLEAR		0x618u
+#define SE_S_IRQ_EN		0x644u
+#define SE_S_IRQ_CLEAR		0x648u
+#define SE_TX_FIFO		0x700u
+#define SE_RX_FIFO		0x780u
+#define SE_TX_FIFO_STATUS	0x800u
+#define SE_RX_FIFO_STATUS	0x804u
+#define SE_HW_PARAM_0		0xe24u
+#define SE_DMA_GENERAL_CFG	0xe30u
+#define SE_GSI_EVENT_EN		0xe18u
+#define SE_IRQ_EN		0xe1cu
+#define GENI_CGC_CTRL		0x028u
+#define GENI_OUTPUT_CTRL	0x024u
+#define GENI_FORCE_DEFAULT	0x020u
+
+#define M_CMD_DONE		(1u << 0)
+#define M_CMD_CANCEL		(1u << 2)
+#define M_CMD_ABORT		(1u << 1)
+#define M_RX_WM			(1u << 26)
+#define M_RX_LAST		(1u << 27)
+#define M_TX_WM			(1u << 30)
+#define M_IRQ_COMMON		0x33c0007eu
+#define M_CMD_ACTIVE		(1u << 0)
+#define RX_FIFO_WC_MSK		0x01ffffffu
+#define RX_LAST			(1u << 31)
+#define IRQ_ERR_BITS		0x0eu
+
+#define OP_TX_ONLY		1u
+#define OP_RX_ONLY		2u
+#define OP_FULL_DUPLEX		3u
+#define PARAM_FRAG		(1u << 2)
+#define TX_FIFO_WC		0x0fffffffu	/* GENI_TX_FIFO_STATUS word count */
+
+/* ---- Himax protocol ---- */
+#define HX_READ_CMD		0xF3u
+#define HX_WRITE_CMD		0xF2u
+#define HX_EVENT_FRAME		56u	/* 10 pt * 4 + 10 z + header/status */
+#define HX_POINT_CNT_OFF	52u	/* finger count byte ((10%4)?12:8 + 40) */
+#define HX_MAX_PT		10u
+#define HX_PANEL_X		1080u
+#define HX_PANEL_Y		2340u
+
+/* 0F constants (hx83112a_noflash.h, verbatim) */
+#define HX_48K_SZ		0xC000u
+#define MAX_TRANS_SZ		240u
+#define ZF_ADDR_SYS_RESET	0x90000018u
+#define ZF_DATA_SYS_RESET	0x00000055u
+#define ZF_DATA_SRAM_START	0x08000000u
+#define ZF_ADDR_DIS_RELOAD	0x10007f00u
+
+static struct {
+	vm_offset_t se, gcc, g03, g99, g125;
+	bool started, dead;
+	uint32_t active, fifodepth;
+	int x[HX_MAX_PT], y[HX_MAX_PT];
+} hx;
+
+/* Bring-up anchors must reach the persistent log even if the kernel dies a
+ * moment later: print, then flush the console ring to UFS synchronously
+ * (the periodic flush thread stops on its first write error). */
+static void
+say(const char *s)
+{
+	printf("SWEET HMAX: %s\n", s);
+	sweet_log_flush_sync();
+}
+
+/* the 64 KiB noflash image, generated from touch.h FW_19691_HX83112A_NF_DSJM;
+ * the header carries its own static declaration (gen_fw_header.py output) */
+#include "sweet_himax_fw_data.h"
+
+static uint32_t
+rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+wr(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static void
+hx_wait(unsigned ms)
+{
+	uint64_t deadline;
+	static int chan;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static bool
+wait_clear(vm_offset_t base, uint32_t off, uint32_t mask)
+{
+	for (unsigned i = 0; i < 5000; ++i) {
+		if (!(rd(base, off) & mask))
+			return true;
+		delay(1);
+	}
+	return false;
+}
+
+static void
+gpio_set(vm_offset_t gbase, unsigned func, unsigned pull, unsigned drive,
+    bool out, bool val)
+{
+	uint32_t cfg = rd(gbase, 0);
+	if (out) {
+		/* io_reg (+4) holds both in (bit 0) and out (bit 1) on this
+		 * TLMM generation (pinctrl-sdm670.c: io_reg +4, out_bit 1);
+		 * latch before enabling output: no glitch on the reset line */
+		wr(gbase, HX_GPIO_IO, val ? (rd(gbase, HX_GPIO_IO) | 2u) :
+		    (rd(gbase, HX_GPIO_IO) & ~2u));
+	}
+	cfg &= ~0x3ffu;
+	cfg |= pull | (func << 2) | (drive << 6) | (out ? 0x200u : 0u);
+	wr(gbase, 0, cfg);
+}
+
+static uint32_t
+gpio_read_irq(void)
+{
+	return rd(hx.g125, HX_GPIO_IO) & 1u;
+}
+
+/* ---- GENI SPI engine ---- */
+
+/* SE_SPI_CPHA bit0, SE_SPI_CPOL bit2 (spi-geni-qcom.c CPHA/CPOL) */
+static void
+se_mode(unsigned pol, unsigned pha)
+{
+	uint32_t cpha = rd(hx.se, SE_SPI_CPHA);
+	uint32_t cpol = rd(hx.se, SE_SPI_CPOL);
+
+	wr(hx.se, SE_SPI_CPHA, pha ? (cpha | 1u) : (cpha & ~1u));
+	wr(hx.se, SE_SPI_CPOL, pol ? (cpol | 4u) : (cpol & ~4u));
+}
+
+static bool
+se_init(void)
+{
+	uint32_t rev = rd(hx.se, SE_FW_REV);
+	hx.fifodepth = (rd(hx.se, SE_HW_PARAM_0) >> 16) & 0x3fu;
+	printf("SWEET HMAX: se fw=%#x proto=%u fifodepth=%u\n",
+	    rev, (rev >> 8) & 0xffu, hx.fifodepth);
+	sweet_log_flush_sync();
+	if (((rev >> 8) & 0xffu) != 1u) {
+		printf("SWEET HMAX: SE is not SPI; abort\n");
+		sweet_log_flush_sync();
+		return false;
+	}
+
+	/* se_io_init + fifo mode (qcom-geni-se.c) — an anchor around EACH of
+	 * the first writes: one of them kills the machine */
+	say("se: about to configure engine");
+	wr(hx.se, GENI_CGC_CTRL, rd(hx.se, GENI_CGC_CTRL) | 0x7fu);
+	say("se: cgc done");
+	wr(hx.se, SE_DMA_GENERAL_CFG, rd(hx.se, SE_DMA_GENERAL_CFG) | 0x0fu);
+	say("se: dma done");
+	wr(hx.se, GENI_OUTPUT_CTRL, 0x7fu);
+	say("se: out done");
+	wr(hx.se, GENI_FORCE_DEFAULT, 1u);
+	say("se: force done");
+	wr(hx.se, SE_IRQ_EN, rd(hx.se, SE_IRQ_EN) | 0x0fu);
+	wr(hx.se, SE_GSI_EVENT_EN, 0);
+	wr(hx.se, SE_GENI_DMA_MODE_EN, rd(hx.se, SE_GENI_DMA_MODE_EN) & ~1u);
+	wr(hx.se, SE_M_IRQ_CLEAR, 0xffffffffu);
+	say("se: m_irq_clear done");
+	wr(hx.se, SE_S_IRQ_CLEAR, 0xffffffffu);
+	say("se cfg2 ok (irq en/clear)");
+	wr(hx.se, SE_M_IRQ_EN, rd(hx.se, SE_M_IRQ_EN) | M_IRQ_COMMON |
+	    M_CMD_DONE | M_RX_WM | M_RX_LAST | M_TX_WM);
+	wr(hx.se, SE_S_IRQ_EN, rd(hx.se, SE_S_IRQ_EN) | M_CMD_DONE);
+	say("se cfg3 ok (m/s irq en)");
+
+	/* SPI mode 3: the vendor driver hard-sets s_client->mode = SPI_MODE_3
+	 * for this panel (hx83112a_noflash.c, in the probe) whatever the DT
+	 * says. mode 0 in every earlier build was a workaround for the
+	 * "commands never complete" stall, which turned out to be the FIFO
+	 * ordering bug — so the IC's real mode has to be retested now. */
+	wr(hx.se, SE_SPI_LOOPBACK, rd(hx.se, SE_SPI_LOOPBACK) & ~0x3u);
+	wr(hx.se, SE_SPI_DEMUX_SEL, 0);
+	se_mode(0, 0);		/* probe decides; mode 3 is opt-in below */
+	wr(hx.se, SE_SPI_DEMUX_OUTPUT_INV, 0);
+	say("se spi mode ok (mode0 default)");
+	say("se: writing clk_sel/ser");
+	wr(hx.se, SE_CLK_SEL, 0);
+	wr(hx.se, SE_SER_M_CLK_CFG, (2u << 4) | 1u);
+	printf("SWEET HMAX: se clk readback sel=%#x ser=%#x\n",
+	    rd(hx.se, SE_CLK_SEL), rd(hx.se, SE_SER_M_CLK_CFG));
+	sweet_log_flush_sync();
+	say("se clocks ok (clk_sel/ser)");
+	/* packing: 4 x 8-bit per FIFO word, MSB first — exactly what the
+	 * vendor se_get_packing_config(8, 4, true) computes. The 0063 goodix
+	 * values (0xc010/0x1c450) do not match that formula; with them the fw
+	 * misparses the fifo stream and every command stalls. */
+	wr(hx.se, SE_GENI_TX_PACKING_CFG0, 0x7f8feu);
+	wr(hx.se, SE_GENI_TX_PACKING_CFG1, 0xffefeu);
+	wr(hx.se, SE_GENI_RX_PACKING_CFG0, 0x7f8feu);
+	wr(hx.se, SE_GENI_RX_PACKING_CFG1, 0xffefeu);
+	wr(hx.se, SE_GENI_BYTE_GRAN, 0);
+	wr(hx.se, SE_SPI_WORD_LEN, (rd(hx.se, SE_SPI_WORD_LEN) & ~0x3ffu) | 4u);
+	wr(hx.se, SE_SPI_DELAY_COUNTERS, 0);
+	say("se packing ok");
+	return true;
+}
+
+static bool
+m_cmd_wait_done(void)
+{
+	/* ~200 ms ceiling: a 48 KiB TX at 9.6 MHz takes ~45 ms; the earlier
+	 * 1 s timeout x 20 safe-mode retries dragged boot out by 12 minutes */
+	for (unsigned i = 0; i < 200000; ++i) {
+		uint32_t irq = rd(hx.se, SE_M_IRQ_STATUS);
+		if (irq & IRQ_ERR_BITS) {
+			wr(hx.se, SE_M_IRQ_CLEAR, irq);
+			printf("SWEET HMAX: m_cmd irq err=%#x st=%#x\n",
+			    irq, rd(hx.se, SE_GENI_STATUS));
+			sweet_log_flush_sync();
+			hx.dead = true;
+			return false;
+		}
+		if (irq & M_CMD_DONE) {
+			wr(hx.se, SE_M_IRQ_CLEAR, irq);
+			return true;
+		}
+		delay(1);
+	}
+	printf("SWEET HMAX: m_cmd timeout st=%#x irq=%#x txwc=%#x rxst=%#x\n",
+	    rd(hx.se, SE_GENI_STATUS), rd(hx.se, SE_M_IRQ_STATUS),
+	    rd(hx.se, SE_TX_FIFO_STATUS), rd(hx.se, SE_RX_FIFO_STATUS));
+	sweet_log_flush_sync();
+	wr(hx.se, SE_M_CMD_CTRL, M_CMD_CANCEL);
+	hx_wait(2);
+	wr(hx.se, SE_M_CMD_CTRL, M_CMD_ABORT);
+	wr(hx.se, SE_M_IRQ_CLEAR, 0xffffffffu);
+	hx.dead = true;
+	return false;
+}
+
+/* one FIFO word = 4 bytes of the wire stream, little-endian within the word */
+static void
+tx_word(const uint8_t *tx, unsigned len, unsigned idx)
+{
+	uint32_t word = 0;
+
+	for (unsigned j = 0; j < 4 && (idx * 4u + j) < len; ++j)
+		word |= (uint32_t)tx[idx * 4u + j] << (8u * j);
+	wr(hx.se, SE_TX_FIFO, word);
+}
+
+static unsigned
+fifo_depth(void)
+{
+	return hx.fifodepth ? hx.fifodepth : 16u;
+}
+
+/*
+ * Start one m_cmd and stream the whole message into the TX FIFO.
+ *
+ * THE ORDER IS THE BUG THAT COST 20 ROUNDS. One word has to be staged
+ * before M_CMD (a completely empty FIFO underruns the sequencer), but every
+ * further word must be pushed *after* the command is running — that is what
+ * the vendor driver does: it issues the command and then refills from the
+ * TX-watermark ISR, so in the working driver not a single word is written
+ * ahead of M_CMD. Pre-filling the whole message (what this file did up to
+ * v6) silently drops the staged words: FIFO count reads 0, M_CMD_DONE never
+ * fires, no error bit is ever set, M_GENI_CMD_ACTIVE stays stuck. That is
+ * the st=0x41 / irq=0 / txwc=0 signature of every "command never completes"
+ * log, at any length and any SPI mode.
+ *
+ * ceil(len/4) words is exactly enough — a FIFO word emits its 4 bytes and
+ * the byte counter (TRANS_LEN, GENI_BYTE_GRAN=0 -> 1 byte per count) stops
+ * the stream mid-word. There is no "+1 prefetch": the fed=ceil(L/4)+1 in
+ * the old probe was its poll loop writing one pad word before its first
+ * DONE check, and only the post-issue words were ever actually sent.
+ */
+static int
+stream_tx(const uint8_t *tx, unsigned len, uint32_t m_cmd)
+{
+	unsigned words = (len + 3u) / 4u;
+	unsigned w = 0;
+	unsigned stall = 0;
+
+	if (!wait_clear(hx.se, SE_GENI_STATUS, M_CMD_ACTIVE)) {
+		hx.dead = true;
+		return EBUSY;
+	}
+	wr(hx.se, SE_M_IRQ_CLEAR, 0xffffffffu);
+	wr(hx.se, SE_SPI_TRANS_CFG, rd(hx.se, SE_SPI_TRANS_CFG) & ~1u);
+	wr(hx.se, SE_SPI_TX_TRANS_LEN, len);
+	wr(hx.se, SE_M_CMD, m_cmd);		/* command first, FIFO after */
+	while (w < words) {
+		unsigned wc = rd(hx.se, SE_TX_FIFO_STATUS) & TX_FIFO_WC;
+
+		if (wc > fifo_depth() - 2u) {
+			if (++stall > 2000u) {
+				printf("SWEET HMAX: tx fifo stuck wc=%u "
+				    "fed=%u/%u st=%#x\n", wc, w, words,
+				    rd(hx.se, SE_GENI_STATUS));
+				sweet_log_flush_sync();
+				hx.dead = true;
+				return EIO;
+			}
+			delay(20);		/* engine is draining */
+			continue;
+		}
+		stall = 0;
+		tx_word(tx, len, w++);
+	}
+	return 0;
+}
+
+/*
+ * One non-fragmented TX-only command; the 48 KiB image is a single command.
+ * M_CMD_DONE fires after TRANS_LEN bytes have been clocked out.
+ */
+static int
+spi_tx(const uint8_t *tx, unsigned len)
+{
+	if (hx.dead || len == 0)
+		return EIO;
+	if (stream_tx(tx, len, OP_TX_ONLY << 27) != 0)
+		return EIO;
+	return m_cmd_wait_done() ? 0 : EIO;
+}
+
+/* RX capture buffer for one full-duplex read: 3 command bytes + up to a
+ * 56-byte event frame (+ slack). The IC only drives MISO after the command
+ * bytes, so the first three captured bytes are discarded. */
+static uint8_t hx_rxbuf[3u + HX_EVENT_FRAME + 4u];
+static uint8_t hx_fdtx[3u + HX_EVENT_FRAME + 4u];
+
+static bool hx_use_fd;
+
+/* un-wedge the bus after a failed command: cancel/abort/clear and revive */
+static void
+bus_reset(void)
+{
+	wr(hx.se, SE_M_CMD_CTRL, M_CMD_CANCEL);
+	hx_wait(2);
+	wr(hx.se, SE_M_CMD_CTRL, M_CMD_ABORT);
+	wr(hx.se, SE_M_IRQ_CLEAR, 0xffffffffu);
+	hx.dead = false;
+}
+
+/*
+ * Full-duplex read: [F3, addr, 00] + len pad bytes out while len+3 bytes
+ * are captured; the first three captured bytes are discarded.
+ */
+static int
+fd_read(uint8_t cmd, uint8_t *data, unsigned len)
+{
+	unsigned total = 3u + len;
+	unsigned got = 0;
+
+	if (hx.dead || len == 0 || len > HX_EVENT_FRAME)
+		return EIO;
+	if (!wait_clear(hx.se, SE_GENI_STATUS, M_CMD_ACTIVE)) {
+		hx.dead = true;
+		return EBUSY;
+	}
+	/* [F3, addr, 00 ...] — the IC drives MISO only after these bytes */
+	for (unsigned i = 0; i < total; ++i)
+		hx_fdtx[i] = 0;
+	hx_fdtx[0] = HX_READ_CMD;
+	hx_fdtx[1] = cmd;
+	wr(hx.se, SE_SPI_RX_TRANS_LEN, total);
+	if (stream_tx(hx_fdtx, total, OP_FULL_DUPLEX << 27) != 0)
+		return EIO;
+	if (!m_cmd_wait_done()) {
+		printf("SWEET HMAX: bus_read fd failed\n");
+		sweet_log_flush_sync();
+		return EIO;
+	}
+	while (got < total) {
+		unsigned wc = rd(hx.se, SE_RX_FIFO_STATUS) & RX_FIFO_WC_MSK;
+		if (wc == 0) {
+			printf("SWEET HMAX: bus_read short rx %u/%u\n", got, total);
+			sweet_log_flush_sync();
+			hx.dead = true;
+			return EIO;
+		}
+		for (unsigned k = 0; k < wc && got < total; ++k) {
+			uint32_t word = rd(hx.se, SE_RX_FIFO);
+			for (unsigned j = 0; j < 4 && got < total; ++j)
+				hx_rxbuf[got++] = (uint8_t)(word >> (8u * j));
+		}
+	}
+	for (unsigned i = 0; i < len; ++i)
+		data[i] = hx_rxbuf[3 + i];
+	return 0;
+}
+
+/*
+ * Fragmented-chain read (the vendor message shape): a FRAG-marked TX-only
+ * command of [F3, addr, 00] (one word pushed, TRANS_LEN=3) holds CS low and
+ * does NOT raise DONE; the RX-only continuation ends the chain. wc prints
+ * reveal whether the engine consumes bytes or whole words.
+ */
+static int
+frag_read(uint8_t cmd, uint8_t *data, unsigned len)
+{
+	unsigned got = 0;
+
+	if (hx.dead || len == 0 || len > HX_EVENT_FRAME)
+		return EIO;
+	if (!wait_clear(hx.se, SE_GENI_STATUS, M_CMD_ACTIVE)) {
+		hx.dead = true;
+		return EBUSY;
+	}
+	{
+		/* 3-byte header fits one FIFO word; the counter stops the
+		 * stream after 3 bytes, so no pad byte reaches the wire */
+		uint8_t hdr[4] = { HX_READ_CMD, cmd, 0, 0 };
+
+		if (stream_tx(hdr, 3, (OP_TX_ONLY << 27) | PARAM_FRAG) != 0)
+			return EIO;
+	}
+	if (!wait_clear(hx.se, SE_TX_FIFO_STATUS, TX_FIFO_WC)) {
+		printf("SWEET HMAX: frag tx drain timeout wc=%#x\n",
+		    rd(hx.se, SE_TX_FIFO_STATUS));
+		sweet_log_flush_sync();
+		hx.dead = true;
+		return EIO;
+	}
+	printf("SWEET HMAX: frag tx drained wc=%#x\n",
+	    rd(hx.se, SE_TX_FIFO_STATUS));
+	sweet_log_flush_sync();
+	delay(10);	/* last bits shift out */
+	wr(hx.se, SE_SPI_RX_TRANS_LEN, len);
+	wr(hx.se, SE_M_CMD, OP_RX_ONLY << 27);
+	for (unsigned i = 0; i < 30000 && got < len; ++i) {
+		uint32_t irq = rd(hx.se, SE_M_IRQ_STATUS);
+		unsigned wc = rd(hx.se, SE_RX_FIFO_STATUS) & RX_FIFO_WC_MSK;
+		for (unsigned k = 0; k < wc && got < len; ++k) {
+			uint32_t word = rd(hx.se, SE_RX_FIFO);
+			for (unsigned j = 0; j < 4 && got < len; ++j)
+				data[got++] = (uint8_t)(word >> (8u * j));
+		}
+		if (got >= len)
+			break;
+		if (irq & IRQ_ERR_BITS) {
+			wr(hx.se, SE_M_IRQ_CLEAR, irq);
+			printf("SWEET HMAX: frag rx irq err=%#x (got %u/%u)\n",
+			    irq, got, len);
+			sweet_log_flush_sync();
+			hx.dead = true;
+			return EIO;
+		}
+		if (irq & (M_RX_WM | M_RX_LAST))
+			wr(hx.se, SE_M_IRQ_CLEAR, irq & (M_RX_WM | M_RX_LAST));
+		delay(1);
+	}
+	if (!m_cmd_wait_done()) {
+		printf("SWEET HMAX: frag rx phase failed (got %u/%u)\n",
+		    got, len);
+		sweet_log_flush_sync();
+		return EIO;
+	}
+	return got == len ? 0 : EIO;
+}
+
+static int
+bus_read(uint8_t cmd, uint8_t *data, unsigned len)
+{
+	return hx_use_fd ? fd_read(cmd, data, len) : frag_read(cmd, data, len);
+}
+
+/*
+ * v7 sequencer self-check. The two probe lengths are the exact transfers
+ * that used to hang forever (10 = the 2+8 byte sys-reset write, 3 = the
+ * read header), and both are TX-only: M_CMD_DONE fires on the host side
+ * whether or not the touch IC is powered. So this single line answers
+ * "did the FIFO ordering fix work" independently of the power vote.
+ */
+/*
+ * Probe one transfer through the real path (stream_tx) and report timing.
+ * Every earlier "command never completes" case pre-staged FIFO words before
+ * M_CMD; the numbers in every log are consistent with those words being
+ * dropped (fed = ceil(L/4)+1 in the old probe = exactly the one pre-staged
+ * word that never counted), so the probe now exercises the production path
+ * instead of a bespoke loop.
+ */
+static int
+probe_xfer(unsigned mode, unsigned len)
+{
+	uint8_t buf[16];
+	uint64_t t0;
+	int rc;
+
+	for (unsigned i = 0; i < sizeof(buf); ++i)
+		buf[i] = 0;
+	buf[0] = 0xF2;
+	t0 = ml_get_timebase();
+	rc = spi_tx(buf, len);
+	printf("SWEET HMAX: probe m%u L=%u rc=%d us=%llu\n", mode, len, rc,
+	    (unsigned long long)((ml_get_timebase() - t0) / 19u));
+	sweet_log_flush_sync();
+	return rc == 0;
+}
+
+static void
+wire_probe(void)
+{
+	int m0_10;
+
+	/* Does a TX FIFO write stick while no command is active? If the count
+	 * reads 0 the words were dropped, which is the whole bring-up story. */
+	wr(hx.se, SE_TX_FIFO, 0x11111111u);
+	wr(hx.se, SE_TX_FIFO, 0x22222222u);
+	printf("SWEET HMAX: idle fifo wc=%u (0 = writes dropped)\n",
+	    rd(hx.se, SE_TX_FIFO_STATUS) & TX_FIFO_WC);
+	sweet_log_flush_sync();
+	wr(hx.se, SE_M_CMD_CTRL, M_CMD_ABORT);
+	wr(hx.se, SE_M_IRQ_CLEAR, 0xffffffffu);
+	hx_wait(10);
+
+	/* mode 0 first: a mode-3 failure wedges everything after it */
+	se_mode(0, 0);
+	(void)probe_xfer(0, 4);
+	m0_10 = probe_xfer(0, 10);
+	(void)probe_xfer(0, 3);
+
+	/* then the panel's real mode, last */
+	se_mode(1, 1);
+	if (probe_xfer(3, 4)) {
+		printf("SWEET HMAX: staying in mode3\n");
+	} else {
+		printf("SWEET HMAX: mode3 dead (m0 L=10 %s)\n",
+		    m0_10 ? "works" : "also dead");
+		se_mode(0, 0);
+	}
+	sweet_log_flush_sync();
+}
+
+/* 0xF2 cmd + up to 4 + 48 KiB payload: the vendor downloads the whole SRAM
+ * image as ONE bus_write burst (himax_bus_write allocates 49152 bytes), and
+ * spi_tx streams it through the FIFO with a refill loop. Single driver
+ * thread, so one static buffer is fine. */
+static uint8_t hx_txbuf[2u + 4u + HX_48K_SZ + 16u];
+
+static int
+bus_write(uint8_t cmd, const uint8_t *data, unsigned len)
+{
+	if (hx.dead || 2u + len > sizeof(hx_txbuf))
+		return EIO;
+	hx_txbuf[0] = HX_WRITE_CMD;
+	hx_txbuf[1] = cmd;
+	for (unsigned i = 0; i < len; ++i)
+		hx_txbuf[2 + i] = data[i];
+	return spi_tx(hx_txbuf, 2u + len);
+}
+
+/* ---- Himax AHB layer (vendor hx83112a_noflash.c logic, verbatim) ---- */
+
+static void
+flash_write_burst(uint32_t addr, const uint8_t *data, unsigned len)
+{
+	uint8_t buf[8];
+	buf[0] = addr & 0xff; buf[1] = (addr >> 8) & 0xff;
+	buf[2] = (addr >> 16) & 0xff; buf[3] = (addr >> 24) & 0xff;
+	for (unsigned i = 0; i < 4 && i < len; ++i)
+		buf[4 + i] = data[i];
+	(void)bus_write(0x00, buf, 8);
+}
+
+static void
+burst_enable(uint8_t auto_add_4)
+{
+	uint8_t d = 0x31;
+	(void)bus_write(0x13, &d, 1);
+	d = (uint8_t)(0x10 | auto_add_4);
+	(void)bus_write(0x0d, &d, 1);
+}
+
+static void
+register_write(uint32_t addr, const uint8_t *data, unsigned len)
+{
+	uint8_t buf[4 + MAX_TRANS_SZ];
+	buf[0] = addr & 0xff; buf[1] = (addr >> 8) & 0xff;
+	buf[2] = (addr >> 16) & 0xff; buf[3] = (addr >> 24) & 0xff;
+	for (unsigned i = 0; i < len && i < MAX_TRANS_SZ; ++i)
+		buf[4 + i] = data[i];
+	burst_enable(len > 4 ? 1 : 0);
+	(void)bus_write(0x00, buf, 4u + len);
+}
+
+static void
+register_read(uint32_t addr, uint8_t *data, unsigned len)
+{
+	uint8_t a[4] = { addr & 0xff, (addr >> 8) & 0xff,
+	    (addr >> 16) & 0xff, (addr >> 24) & 0xff };
+	uint8_t zero = 0;
+	burst_enable(len > 4 ? 1 : 0);
+	(void)bus_write(0x00, a, 4);
+	(void)bus_write(0x0c, &zero, 1);
+	(void)bus_read(0x08, data, len);
+	if (len > 4)
+		burst_enable(0);
+}
+
+static void
+interface_on(void)
+{
+	uint8_t d[5];
+	uint8_t chk1 = 0, chk2 = 0;
+	if (bus_read(0x08, d, 4) != 0) {
+		printf("SWEET HMAX: if_on dummy read failed\n");
+		sweet_log_flush_sync();
+		return;
+	}
+	for (unsigned cnt = 0; cnt < 10; ++cnt) {
+		uint8_t b31 = 0x31, b10 = 0x10;
+		(void)bus_write(0x13, &b31, 1);
+		(void)bus_write(0x0d, &b10, 1);
+		(void)bus_read(0x13, &chk1, 1);
+		(void)bus_read(0x0d, &chk2, 1);
+		if (chk1 == 0x31 && chk2 == 0x10) {
+			printf("SWEET HMAX: if_on ok, bus alive (%u tries)\n", cnt);
+			sweet_log_flush_sync();
+			return;
+		}
+		hx_wait(1);
+	}
+	printf("SWEET HMAX: if_on FAILED chk=%02x/%02x (ic not answering)\n",
+	    chk1, chk2);
+	sweet_log_flush_sync();
+}
+
+/* ---- 0F firmware download (vendor verbatim logic) ---- */
+
+static uint32_t
+hw_check_crc(uint32_t start_addr, unsigned len)
+{
+	uint8_t d4[4];
+	uint8_t sa[4] = { start_addr & 0xff, (start_addr >> 8) & 0xff,
+	    (start_addr >> 16) & 0xff, (start_addr >> 24) & 0xff };
+	uint8_t len4[4] = { (len / 4) & 0xff, ((len / 4) >> 8) & 0xff, 0x99, 0x00 };
+
+	flash_write_burst(0x80050020u, sa, 4);
+	flash_write_burst(0x80050028u, len4, 4);
+	for (unsigned cnt = 0; cnt < 100; ++cnt) {
+		register_read(0x80050000u, d4, 4);
+		if (!(d4[0] & 0x01u)) {
+			register_read(0x80050018u, d4, 4);
+			return ((uint32_t)d4[3] << 24) | ((uint32_t)d4[2] << 16) |
+			    ((uint32_t)d4[1] << 8) | d4[0];
+		}
+	}
+	return 0xffffffffu;
+}
+
+/* the vendor writes each SRAM region (incl. the full 48 KiB image) as ONE
+ * flash_write_burst_length burst: addr prefix + payload, auto-increment on */
+static uint8_t hx_sram[4u + HX_48K_SZ];
+
+static void
+write_sram_0f(uint32_t dest, unsigned src_off, unsigned len)
+{
+	hx_sram[0] = dest & 0xff;
+	hx_sram[1] = (dest >> 8) & 0xff;
+	hx_sram[2] = (dest >> 16) & 0xff;
+	hx_sram[3] = (dest >> 24) & 0xff;
+	for (unsigned i = 0; i < len; ++i)
+		hx_sram[4 + i] = himax_fw_19691[src_off + i];
+	burst_enable(1);
+	(void)bus_write(0x00, hx_sram, 4u + len);
+}
+
+static bool
+enter_safe_mode(void)
+{
+	uint8_t a5[4] = { 0xa5, 0, 0, 0 };
+	uint8_t zero[4] = { 0, 0, 0, 0 };
+	uint8_t one[4] = { 1, 0, 0, 0 };
+	uint8_t d4[4];
+
+	flash_write_burst(0x9000005cu, a5, 4);
+	hx_wait(20);
+	for (unsigned cnt = 0; cnt < 3; ++cnt) {
+		uint8_t b27 = 0x27, b95 = 0x95, b00 = 0x00;
+		(void)bus_write(0x31, &b27, 1);
+		(void)bus_write(0x32, &b95, 1);
+		(void)bus_write(0x31, &b00, 1);
+		(void)bus_write(0x31, &b27, 1);
+		(void)bus_write(0x32, &b95, 1);
+		register_read(0x900000a8u, d4, 4);
+		printf("SWEET HMAX: safe mode try %u a8=%02x%02x%02x%02x\n",
+		    cnt, d4[0], d4[1], d4[2], d4[3]);
+		sweet_log_flush_sync();
+		if (d4[0] == 0x0cu) {
+			/* reset TCON, then ADC (vendor enter_safe_mode tail) */
+			flash_write_burst(0x80020020u, zero, 4);
+			hx_wait(1);
+			flash_write_burst(0x80020020u, one, 4);
+			flash_write_burst(0x80020094u, zero, 4);
+			hx_wait(1);
+			flash_write_burst(0x80020094u, one, 4);
+			return true;
+		}
+		hx_wait(10);
+	}
+	return false;
+}
+
+static void
+sense_on(void)
+{
+	uint8_t zero[4] = { 0, 0, 0, 0 };
+	uint8_t r55[4] = { 0x55, 0, 0, 0 };
+	interface_on();				/* vendor sense_on leads
+						 * with the burst handshake */
+	flash_write_burst(0x9000005cu, zero, 4);
+	register_write(0x90000018u, r55, 4);	/* AHBI2C system reset */
+}
+
+static bool
+fw_download(void)
+{
+	uint8_t d4[4];
+	uint32_t crc = 0xffffffffu;
+
+	say("step: enter safe mode");
+	if (!enter_safe_mode()) {
+		printf("SWEET HMAX: safe mode failed\n");
+		sweet_log_flush_sync();
+		return false;
+	}
+	say("safe mode ok");
+	say("step: 48k image + CRC");
+	for (unsigned retry = 0; retry < 10 && crc != 0; ++retry) {
+		write_sram_0f(ZF_DATA_SRAM_START, 0, HX_48K_SZ);
+		crc = hw_check_crc(ZF_DATA_SRAM_START, HX_48K_SZ);
+		if (crc != 0) {
+			printf("SWEET HMAX: 48k CRC fail (%#x) retry %u\n", crc, retry);
+			sweet_log_flush_sync();
+		}
+	}
+	if (crc != 0)
+		return false;
+	say("48k crc ok");
+	say("step: config tables");
+	write_sram_0f(0x10007000u, 0xC000u, 128u);
+	write_sram_0f(0x10007084u, 0xC100u, 528u);
+	write_sram_0f(0x10007300u, 0xCA00u, 128u);
+	write_sram_0f(0x10006A00u, 0xD640u, 1200u);
+	write_sram_0f(0x10007B28u, 0xD320u, 800u);
+	write_sram_0f(0x10007500u, 0xE000u, 1536u);
+	write_sram_0f(0x10007294u, 0xC30Cu, 4u);	/* mode switch: poweron
+							 * (0xC30C: the <=64K
+							 * path; 0xC33C is the
+							 * >64K bin path) */
+	say("tables written");
+	say("step: dis reload + fw id");
+
+	/* disable flash reload, verify readback (vendor hx_dis_rload_0f) */
+	uint8_t dr[4] = { 0xa9, 0x9a, 0x00, 0x00 };
+	flash_write_burst(ZF_ADDR_DIS_RELOAD, dr, 4);
+	register_read(ZF_ADDR_DIS_RELOAD, d4, 4);
+	if (d4[3] || d4[2] || d4[1] != 0x9au || d4[0] != 0xa9u) {
+		printf("SWEET HMAX: reload verify=%02x%02x%02x%02x (want 00009aa9)\n",
+		    d4[3], d4[2], d4[1], d4[0]);
+		sweet_log_flush_sync();
+	}
+	hx_wait(10);
+	register_read(0x10007014u, d4, 4);		/* FW ID */
+	printf("SWEET HMAX: fw id = %02x%02x%02x%02x (want ea159003)\n",
+	    d4[0], d4[1], d4[2], d4[3]);
+	sweet_log_flush_sync();
+	say("step: sense on");
+	sense_on();
+	hx_wait(10);
+	return true;
+}
+
+/* ---- event frame ---- */
+
+static bool
+read_frame(uint8_t *buf)
+{
+	uint8_t off = 0, on = 1;
+	if (bus_write(0x11, &off, 1) != 0)		/* AHB burst read off */
+		return false;
+	if (bus_read(0x30, buf, HX_EVENT_FRAME) != 0)
+		return false;
+	(void)bus_write(0x11, &on, 1);			/* burst read on */
+	return true;
+}
+
+static void
+report(uint32_t mask, const int *x, const int *y)
+{
+	for (unsigned id = 0; id < HX_MAX_PT; ++id) {
+		uint32_t bit = 1u << id;
+		if (mask & bit) {
+			if (!(hx.active & bit) || x[id] != hx.x[id] || y[id] != hx.y[id])
+				sweet_hid_touch((int)id, 1, x[id], y[id]);
+			hx.x[id] = x[id];
+			hx.y[id] = y[id];
+		} else if (hx.active & bit) {
+			sweet_hid_touch((int)id, 0, hx.x[id], hx.y[id]);
+		}
+	}
+	hx.active = mask;
+}
+
+static void
+hx_thread(void *arg, wait_result_t result)
+{
+	unsigned delay_s = 45;
+	(void)arg;
+	(void)result;
+	(void)PE_parse_boot_argn("sweetmaxdelay", &delay_s, sizeof(delay_s));
+	/* self-identifying banner: three separate rounds were spent guessing
+	 * which build was actually running. Never infer it from wording. */
+	printf("SWEET HMAX: v10 cmd-first, no pre-stage "
+	    "rsc=%#x\n", 0x179e0000u);
+	printf("SWEET HMAX: starting in %u s\n", delay_s);
+	hx_wait(delay_s * 1000u);
+
+	hx.se = ml_io_map(HX_SE_PA, 0x4000);
+	hx.gcc = ml_io_map(HX_GCC_PA, 0x60000);
+	hx.g03 = ml_io_map(HX_TLMM_PA + HX_TLMM_SOUTH, 4u * HX_GPIO_PAGE);
+	hx.g99 = ml_io_map(HX_TLMM_PA + HX_TLMM_NORTH + 99u * HX_GPIO_PAGE,
+	    HX_GPIO_PAGE);
+	hx.g125 = ml_io_map(HX_TLMM_PA + HX_TLMM_NORTH + 125u * HX_GPIO_PAGE,
+	    HX_GPIO_PAGE);
+	if (!hx.se || !hx.gcc || !hx.g03 || !hx.g99 || !hx.g125) {
+		printf("SWEET HMAX: MMIO map failed\n");
+		sweet_log_flush_sync();
+		goto out;
+	}
+	say("maps ok");
+	/* touch power: TWRP (touch working) runs pm660l_l7 at 3.09 V (the TP
+	 * AVDD; vendor tp_powercontrol_2v8 sets 3.1 V) plus a 1.8 V VDDIO —
+	 * nobody re-votes these under XNU, so the IC never answers. Vote the
+	 * AVDD and the 1.8 V candidates before touching the bus. */
+	{
+		/* cmd-db resource names are ldo<pmic-index-letter><n> (the
+		 * sirius board votes "ldoc11"); pm660=a, pm660l=b here */
+		int r7 = sweet_rpmh_vreg_enable("ldob7", 3088);
+		int r13 = sweet_rpmh_vreg_enable("ldoa13", 1800);
+		int r14 = sweet_rpmh_vreg_enable("ldoa14", 1800);
+		printf("SWEET HMAX: vreg ldob7=%d ldoa13=%d ldoa14=%d\n",
+		    r7, r13, r14);
+		sweet_log_flush_sync();
+	}
+	hx_wait(50);	/* rail ramp */
+	/* clocks: vote SE0's serial clock (wrap0 S0) + wrap0 ahb. The first
+	 * bring-up voted S1 by mistake and the FORCE_DEFAULT write then died
+	 * on a dead core clock */
+	wr(hx.gcc, HX_GCC_VOTE, rd(hx.gcc, HX_GCC_VOTE) |
+	    HX_GCC_S0_BIT | HX_GCC_AHB0_BIT);
+	printf("SWEET HMAX: vote=%#x s0 cbcr=%#x cmd=%#x cfg=%#x\n",
+	    rd(hx.gcc, HX_GCC_VOTE), rd(hx.gcc, HX_RCG_S0_CBCR),
+	    rd(hx.gcc, HX_RCG_S0_CBCR + 4u), rd(hx.gcc, HX_RCG_S0_CBCR + 8u));
+	/* branch CBCR CLK_OFF is bit 31 (clk-branch.c BRANCH_HALT) */
+	if (!wait_clear(hx.gcc, HX_RCG_S0_CBCR, 1u << 31)) {
+		printf("SWEET HMAX: RCG halt timeout (cbcr=%#x)\n",
+		    rd(hx.gcc, HX_RCG_S0_CBCR));
+		sweet_log_flush_sync();
+		goto out;
+	}
+	printf("SWEET HMAX: clock settled s0 cbcr=%#x cfg=%#x\n",
+	    rd(hx.gcc, HX_RCG_S0_CBCR), rd(hx.gcc, HX_RCG_S0_CBCR + 8u));
+	{
+		/* 4.9 GENI S clocks: DFS enable at cmd_rcgr+0x14, per-slot
+		 * CFG-format banks at cmd_rcgr+0x1c+i*4. With DFS on, the
+		 * kernel never programs the RCG — the slots come from boot
+		 * firmware, and an unprogrammed slot (0) = no serial clock
+		 * at all, which is exactly our bring-up stall. */
+		unsigned dfs = rd(hx.gcc, HX_RCG_S0_CBCR + 0x18u);
+		printf("SWEET HMAX: dfs en=%#x slots %#x %#x %#x %#x\n",

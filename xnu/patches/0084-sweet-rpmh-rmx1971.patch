From: SWEET RMX1971 port (ZCode agent + AppleCampus)
Subject: [PATCH 0084] sweet: retarget rpmh to RMX1971 apps_rsc, generic vreg votes

RMX1971 (sdm670 family): apps_rsc tcs-drv @0x179e0000/+0xd00 (DT
qcom,drv-id 2, tcs-config ACTIVE 3), cmd-db locator @0x0c3f000c
(unchanged). Relax the ldoc11-only wrapper so touch rails such as
pm660l_l7 can be voted by cmd-db resource name.

--- a/bsd/dev/sweet_rpmh.c
+++ b/bsd/dev/sweet_rpmh.c
@@ -16,7 +16,7 @@
 /* Live downstream DT has two positional reg entries, no reg-names. */
-#define RH_RSC_PA       0x18220000u
-#define RH_TCS_PA       0x18220d00u
 #define RH_TCS_SIZE     0x3000u
 #define RH_DICT_PA      0x0c3f000cu
 #define RH_DRV          2u
-#define RH_ACTIVE_N     2u       /* DT order: ACTIVE 2, SLEEP 3, WAKE 3 */
+#define RH_RSC_PA       0x179e0000u
+#define RH_TCS_PA       0x179e0d00u
+#define RH_ACTIVE_N     3u       /* RMX1971 DT: ACTIVE 3, SLEEP 3, WAKE 2 */
--- a/bsd/dev/sweet_rpmh.c
+++ b/bsd/dev/sweet_rpmh.c
@@ -327,8 +329,10 @@
 int
 sweet_rpmh_vreg_enable(const char *res, unsigned mv)
 {
-	/* Board-specific helper: do not apply PMIC5-LDO policy to arbitrary resources. */
-	if (!res || strcmp(res, "ldoc11") || mv < 2950 || mv > 3400) {
-		printf("SWEET RPMH: expected ldoc11 and 2950..3400 mV\n");
-		return EINVAL;
-	}
+	/* Generic PMIC5-LDO ARC vote (voltage@0, HPM@8, enable@4); the
+	 * geometry checks in rh_map() refuse mismatched hardware. */
+	if (!res || !res[0] || mv < 800 || mv > 3600) {
+		printf("SWEET RPMH: bad vreg request %s %u mV\n",
+			res ? res : "(null)", mv);
+		return EINVAL;
+	}
--- a/bsd/dev/sweet_rpmh.c
+++ b/bsd/dev/sweet_rpmh.c
@@ -148,6 +172,30 @@
 	if (magic != RH_DB_MAGIC || db_version != 1 || (flags & 1u)) {
 		printf("SWEET RPMH: unsupported/standalone cmd-db\n");
 		return EINVAL;
 	}
+	/* enumerate resource names so board bring-up can see the truth */
+	for (uint32_t e = RH_DB_HEADER, shown = 0;
+		    e + RH_DB_ENTRY <= rh_db_size && shown < 120;
+		    e += RH_DB_ENTRY) {
+		uint32_t key[2] = { rh_read(rh_db, e), rh_read(rh_db, e + 4) };
+		char nm[9];
+		if (!(key[0] | key[1])) {
+			continue;
+		}
+		for (unsigned i = 0; i < 8; ++i) {
+			nm[i] = (char)((key[i / 4] >> (8u * (i % 4))) & 0xffu);
+		}
+		nm[8] = 0;
+		for (unsigned i = 0; i < 8; ++i) {
+			if (nm[i] && (nm[i] < 0x20 || nm[i] > 0x7e)) {
+				nm[0] = 0;
+				break;
+			}
+		}
+		if (nm[0]) {
+			printf("SWEET RPMH: res %s\n", nm);
+			++shown;
+		}
+	}
 	return 0;
 }
--- a/bsd/dev/sweet_rpmh.c
+++ b/bsd/dev/sweet_rpmh.c
@@ -269,28 +270,29 @@
-	/* HPM (raw 7) is supported by this PMIC5 LDO; enable comes last. */
-	const uint32_t offsets[3] = {0, 8, 4};
-	const uint32_t values[3] = {mv, 7, 1};
-	printf("SWEET RPMH: TCS%u ACTIVE %u mV mode=7 enable=1 irq-enable=%#x\n", t, mv, irq_en);
-	for (unsigned c = 0; c < 3; ++c) {
+	/* pmic4-ldo (per DT regulator-type): voltage + enable only; the
+	 * rail powers up in its DT init-mode, and a PMIC5 mode code would NAK */
+	const uint32_t offsets[2] = {0, 4};
+	const uint32_t values[2] = {mv, 1};
+	printf("SWEET RPMH: TCS%u ACTIVE %u mV enable=1 irq-enable=%#x\n", t, mv, irq_en);
+	for (unsigned c = 0; c < 2; ++c) {
 		uint32_t cmd = b + c * RH_CMD_STRIDE;
 		if (!rh_sync(cmd + RH_MSGID, RH_WRITE_ACK) ||
 		    !rh_sync(cmd + RH_ADDR, address + offsets[c]) ||
 		    !rh_sync(cmd + RH_DATA, values[c])) {
 			return EIO;
 		}
 	}
-	if (!rh_sync(b + RH_WAIT, 7) || !rh_sync(b + RH_ENABLE, 7) ||
+	if (!rh_sync(b + RH_WAIT, 3) || !rh_sync(b + RH_ENABLE, 3) ||
 	    !rh_sync(b + RH_CONTROL, 0) || !rh_sync(b + RH_CONTROL, RH_AMC_EN)) {
 		return EIO;
 	}
 	rh_write(rh_tcs, b + RH_CONTROL, RH_AMC_EN | RH_TRIGGER);
-	uint32_t irq = 0, idle = 0, status[3] = {0, 0, 0};
+	uint32_t irq = 0, idle = 0, status[2] = {0, 0};
 	bool done = false, progress = false;
 	for (unsigned us = 0; us < RH_TIMEOUT_US; ++us) {
 		irq = rh_read(rh_tcs, RH_IRQ_STATUS);
 		idle = rh_read(rh_tcs, b + RH_STATUS);
 		bool complete = true;
-		for (unsigned c = 0; c < 3; ++c) {
+		for (unsigned c = 0; c < 2; ++c) {
 			status[c] = rh_read(rh_tcs, b + RH_CMD_STATUS + c * RH_CMD_STRIDE);
 			complete &= status[c] != 0xffffffffu &&
 			    (status[c] & (RH_ISSUED | RH_COMPLETE)) == (RH_ISSUED | RH_COMPLETE);
 		}
